---
import { url } from '../../../lib/url';
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import WorkCard from '../../../components/WorkCard.astro';
import MiniCard from '../../../components/MiniCard.astro';
import { categories } from '../../../data/site';
import { getWorks, cases, minis } from '../../../lib/works';

export const getStaticPaths = (() =>
  categories.map((c, i) => ({ params: { category: c.id }, props: { category: c, next: categories[i + 1] } }))) satisfies GetStaticPaths;

const { category, next } = Astro.props;
const works = await getWorks(category.id);
const caseList = cases(works);
const miniList = minis(works);
const tabs = [...categories.map((c) => ({ label: c.title, href: url(`/works/${c.id}/`), active: c.id === category.id })), { label: '其他歷程', href: url('/archive/'), active: false }];
const nextLink = next ? { title: next.title, href: url(`/works/${next.id}/`) } : { title: '其他 / 榮譽歷程', href: url('/archive/') };
---
<Layout title={category.title} description={category.philosophy}>
  <section class="container-page flex flex-col gap-10 pt-16 pb-12 md:pt-20">
    <p class="font-mono text-[13px] text-muted">作品 / {category.title}</p>
    <div class="flex flex-wrap items-end justify-between gap-8">
      <div class="flex max-w-2xl flex-col gap-5">
        <p class="eyebrow">Category {category.index} / 04</p>
        <h1 class="text-5xl font-bold md:text-[64px]">{category.title}</h1>
        <p class="text-lg leading-[1.7] text-muted">{category.philosophy}</p>
      </div>
      <div class="flex flex-col items-end gap-2">
        <span class="text-7xl leading-none font-bold">{String(caseList.length).padStart(2, '0')}</span>
        <span class="eyebrow">Case Studies</span>
      </div>
    </div>
    <nav aria-label="作品分類" class="flex gap-8 overflow-x-auto border-t-[1.5px] border-ink">
      {tabs.map((t) => (
        <a href={t.href} aria-current={t.active ? 'page' : undefined} class:list={['shrink-0 border-t-[3px] pt-4 text-[15px]', t.active ? 'border-sun font-bold' : 'border-transparent text-muted hover:text-ink']}>
          {t.label}
        </a>
      ))}
    </nav>
  </section>

  <section class="container-page flex flex-col gap-6 pb-16">
    <p class="flex items-center gap-3"><span class="eyebrow !text-ink">Case Studies</span><span class="text-[13px] text-muted">— 點擊進入完整案例頁</span></p>
    <div class="grid gap-6 md:grid-cols-2">
      {caseList.map((w, i) => (
        <div class:list={[caseList.length % 2 === 1 && i === caseList.length - 1 && 'md:col-span-2']}>
          <WorkCard work={w} wide={caseList.length % 2 === 1 && i === caseList.length - 1} />
        </div>
      ))}
    </div>
  </section>

  {miniList.length > 0 && (
    <section class="container-page flex flex-col gap-6 pb-24">
      <p class="flex items-center gap-3 border-t-[1.5px] border-ink pt-6"><span class="eyebrow !text-ink">{category.miniTitle}</span><span class="text-[13px] text-muted">— {category.miniNote}</span></p>
      <div class="flex flex-wrap gap-6">{miniList.map((w) => <MiniCard work={w} />)}</div>
    </section>
  )}

  <section class="container-page pb-28">
    <a href={nextLink.href} class="card flex items-center justify-between p-10 transition md:p-12">
      <span class="flex flex-col gap-2"><span class="eyebrow">Next Domain</span><span class="text-3xl font-bold md:text-4xl">{nextLink.title}</span></span>
      <span class="text-5xl" aria-hidden="true">→</span>
    </a>
  </section>
</Layout>
