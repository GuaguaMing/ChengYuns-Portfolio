---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import SectionHeader from '../components/SectionHeader.astro';
import WorkCard from '../components/WorkCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import { categories, profile } from '../data/site';
import { honors } from '../data/honors';
import { getWorks, cases } from '../lib/works';
import { getWorkMedia, getHonorImage } from '../lib/media';

const works = await getWorks();
const featured = works.filter((w) => w.data.featured);
const domainCards = [
  ...categories.map((c) => {
    const list = cases(works.filter((w) => w.data.category === c.id));
    return {
      href: `/works/${c.id}/`,
      index: c.index,
      title: c.title,
      keywords: c.keywords,
      count: `${list.length} Projects`,
      cover: list.map((w) => getWorkMedia(w.id).cover).find(Boolean),
    };
  }),
  {
    href: '/archive/',
    index: '04',
    title: '其他 / 榮譽歷程',
    keywords: 'Awards · Certificate · Community',
    count: `${honors.length} Items`,
    cover: getHonorImage('chairman-award'),
  },
];
---
<Layout>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <!-- 兩個專色版的網點圓，錯開疊印出第三色 -->
    <div aria-hidden="true" class="pointer-events-none absolute -top-48 -right-32 -z-20 size-[640px] rounded-full halftone-mint riso-grain overprint"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-40 -z-20 size-[460px] rounded-full halftone-sun riso-grain overprint"></div>
    <!-- 模型舞台：佔右側約三分之二，可被文字層蓋到 -->
    <div class="absolute inset-x-0 top-0 h-[max(560px,calc(100svh-72px))] md:left-auto md:w-[68%]">
      <HeroCanvas />
    </div>
    <div class="container-page relative flex min-h-[max(560px,calc(100svh-72px))] flex-col items-start justify-end pb-8 md:justify-center md:pb-0">
      <!-- 手機版文字會疊在模型上：加一層淡淡的紙色底降低干擾；在頂部時只顯示模型，往下滑才浮現 -->
      <div
        data-hero-copy
        class="flex flex-col items-start gap-5 rounded-[4px] bg-surface/80 p-5 backdrop-blur-sm transition duration-500 data-hidden:translate-y-6 data-hidden:opacity-0 motion-reduce:transition-none md:gap-7 md:bg-transparent md:p-0 md:backdrop-blur-none"
      >
        <p class="eyebrow">Ψ — {profile.nameEn} · Portfolio 2026</p>
        <h1 class="text-4xl leading-[1.25] font-bold md:text-[54px]">
          <span class="sr-only">{profile.name}｜{profile.role} 作品集：</span>把複雜系統，<br />轉譯成人能信任的介面。
        </h1>
        <p class="max-w-[540px] text-lg leading-[1.7] text-muted">
          {profile.name}｜{profile.role}，現任遊石設計。從遊戲開發、原創玩具品牌，到醫療照護與公共資訊平台，我在研究、設計與工程的交界，降低使用者的認知負擔。
        </p>
      </div>
      <script is:inline>
        // 緊接在元素後執行，避免載入時文字先閃一下
        (() => {
          const copy = document.querySelector('[data-hero-copy]');
          const mobile = matchMedia('(max-width: 767.98px)');
          const update = () => copy.toggleAttribute('data-hidden', mobile.matches && scrollY < 24);
          addEventListener('scroll', update, { passive: true });
          mobile.addEventListener('change', update);
          update();
        })();
      </script>
    </div>
    <!-- 整排 Ψ：藍版＋黃版網點疊印，黃版往右下錯版 -->
    <div aria-hidden="true" class="container-page relative pt-10 select-none">
      <div class="relative text-[9vw] leading-[0.9] font-bold">
        <p class="flex justify-between halftone-text-mint riso-grain overprint">{Array.from({ length: 10 }, () => <span>Ψ</span>)}</p>
        <p class="absolute inset-0 flex translate-x-[0.035em] translate-y-[0.025em] justify-between halftone-text-sun riso-grain overprint">
          {Array.from({ length: 10 }, () => <span>Ψ</span>)}
        </p>
      </div>
    </div>
  </section>

  <!-- Featured -->
  <section id="featured" class="container-page flex scroll-mt-24 flex-col gap-12 pt-24 md:pt-32">
    <SectionHeader eyebrow="00 — Selected Works" title="精選案例">
      <Button href="#domains" variant="secondary">全部作品</Button>
    </SectionHeader>
    <div class="grid gap-6 md:grid-cols-3">{featured.map((w) => <WorkCard work={w} />)}</div>
  </section>

  <!-- Domains -->
  <section id="domains" class="container-page flex scroll-mt-24 flex-col gap-12 py-24 md:py-32">
    <SectionHeader eyebrow="01 — Work Domains" title="四大核心領域" desc="從研究到落地：介面、實體、遊戲，以及一路累積的榮譽歷程。" />
    <div class="grid gap-6 md:grid-cols-2">{domainCards.map((c) => <CategoryCard {...c} />)}</div>
  </section>

  <!-- About teaser -->
  <section class="container-page pb-24 md:pb-32">
    <div class="relative isolate grid items-center gap-10 overflow-hidden rounded-[4px] border-[1.5px] border-ink p-10 md:grid-cols-[auto_1fr] md:p-16">
      <div aria-hidden="true" class="absolute inset-0 -z-10 halftone-sun riso-grain"></div>
      <span class="text-[120px] leading-none font-bold text-overprint md:text-[200px]" aria-hidden="true">Ψ</span>
      <div class="flex flex-col items-start gap-6">
        <p class="eyebrow !text-ink">02 — About</p>
        <h2 class="text-3xl font-bold">Ψ 代表量子、認知與系統幾何。</h2>
        <p class="max-w-2xl leading-[1.8]">
          我在研究、設計與工程的交界工作。從遊戲、玩具品牌到醫療與公共平台，目標始終一致：降低使用者的認知負擔、建立防錯機制，讓人能信任背後的系統。
        </p>
        <Button href="/about/">認識我</Button>
      </div>
    </div>
  </section>
</Layout>
