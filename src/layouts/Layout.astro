---
import '../styles/global.css'; 
interface Props { title: string; }
const { title } = Astro.props;
---
<!doctype html>
<html lang="zh-Hant">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
    </head>
    <body class="bg-[#121212] text-white selection:bg-pink-500 font-sans leading-relaxed">
        <nav class="fixed top-5 right-5 z-50 flex flex-col gap-3 items-end">
            <a href="/" class="px-4 py-1 text-sm font-mono transition-all duration-200 border border-black shadow-[4px_4px_0px_rgba(255,255,255,0.15)] bg-white text-black -rotate-2 hover:rotate-0 hover:shadow-none hover:translate-x-1 hover:translate-y-1 active:scale-95">
                HOME
            </a>
            
            <a href="/projects" class="px-4 py-1 text-sm font-mono transition-all duration-200 border border-black shadow-[4px_4px_0px_rgba(255,255,255,0.15)] bg-yellow-400 text-black rotate-3 hover:rotate-0 hover:shadow-none hover:translate-x-1 hover:translate-y-1 active:scale-95">
                WORKS
            </a>
            
            <a href="/about" class="px-4 py-1 text-sm font-mono transition-all duration-200 border border-black shadow-[4px_4px_0px_rgba(255,255,255,0.15)] bg-purple-600 text-white -rotate-1 hover:rotate-0 hover:shadow-none hover:translate-x-1 hover:translate-y-1 font-bold active:scale-95">
                ABOUT
            </a>
        </nav>

        <slot />

        <style is:global>
            /* 讓滾動條也變得黑黑的，符合你的風格 */
            ::-webkit-scrollbar {
                width: 8px;
            }
            ::-webkit-scrollbar-track {
                background: #121212;
            }
            ::-webkit-scrollbar-thumb {
                background: #333;
                border-radius: 10px;
            }
            ::-webkit-scrollbar-thumb:hover {
                background: #444;
            }
            
            html {
                cursor: default;
                scroll-behavior: smooth;
            }
        </style>
    </body>
</html>