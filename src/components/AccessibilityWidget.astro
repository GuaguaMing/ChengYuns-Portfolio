---
// AccessibilityWidget.astro
// 使用方式：在 Layout.astro 或任何頁面底部加入 <AccessibilityWidget />
// 不需要任何 props，自動掛載
---

<div id="a11y-widget" aria-label="無障礙設定" role="region">

  <!-- 懸浮觸發按鈕 -->
  <button
    id="a11y-trigger"
    aria-expanded="false"
    aria-controls="a11y-panel"
    aria-label="開啟無障礙設定"
    title="無障礙設定"
  >
    <!-- 通用無障礙人型圖示 (WAI icon) -->
    <svg
      width="26" height="26" viewBox="0 0 24 24"
      fill="none" aria-hidden="true" focusable="false"
    >
      <circle cx="12" cy="4" r="2" fill="currentColor"/>
      <path d="M12 7c-2.5 0-4.5 2-4.5 4.5V14h2v-2.5c0-1.4 1.1-2.5 2.5-2.5s2.5 1.1 2.5 2.5V14h2v-2.5C16.5 9 14.5 7 12 7z" fill="currentColor"/>
      <path d="M8 14.5l1 5h2.5l.5-3 .5 3H15l1-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    </svg>
    <span class="a11y-trigger-label">無障礙</span>
  </button>

  <!-- 展開面板 -->
  <div
    id="a11y-panel"
    role="dialog"
    aria-label="無障礙設定面板"
    aria-modal="false"
    hidden
  >
    <div class="a11y-panel-header">
      <span class="a11y-panel-title">無障礙設定</span>
      <button id="a11y-close" aria-label="關閉無障礙設定">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="a11y-section">
      <div class="a11y-section-label">文字大小</div>
      <div class="a11y-btn-group" role="group" aria-label="文字大小選項">
        <button class="a11y-option" data-action="font" data-value="normal" aria-pressed="true">
          <span class="a11y-option-icon" style="font-size:13px">A</span>
          <span>標準</span>
        </button>
        <button class="a11y-option" data-action="font" data-value="large" aria-pressed="false">
          <span class="a11y-option-icon" style="font-size:16px">A</span>
          <span>大字</span>
        </button>
        <button class="a11y-option" data-action="font" data-value="xl" aria-pressed="false">
          <span class="a11y-option-icon" style="font-size:20px">A</span>
          <span>超大</span>
        </button>
      </div>
    </div>

    <div class="a11y-section">
      <div class="a11y-section-label">色彩</div>
      <div class="a11y-btn-group" role="group" aria-label="色彩主題選項">
        <button class="a11y-option" data-action="contrast" data-value="normal" aria-pressed="true">
          <span class="a11y-option-icon">
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M9 1v16" stroke="currentColor" stroke-width="1.2"/><path d="M9 1a8 8 0 010 16z" fill="currentColor"/></svg>
          </span>
          <span>正常</span>
        </button>
        <button class="a11y-option" data-action="contrast" data-value="high" aria-pressed="false">
          <span class="a11y-option-icon">
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="9" r="8" fill="currentColor"/><circle cx="9" cy="9" r="5" fill="white"/></svg>
          </span>
          <span>高對比</span>
        </button>
        <button class="a11y-option" data-action="contrast" data-value="dark" aria-pressed="false">
          <span class="a11y-option-icon">
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 2a7 7 0 100 14A7 7 0 009 2z" fill="currentColor"/><path d="M9 2a7 7 0 010 14" fill="white"/></svg>
          </span>
          <span>暗色</span>
        </button>
      </div>
    </div>

    <div class="a11y-section">
      <div class="a11y-section-label">閱讀輔助</div>
      <div class="a11y-toggle-list">
        <label class="a11y-toggle">
          <span class="a11y-toggle-label">減少動畫效果</span>
          <div class="a11y-switch" role="switch">
            <input type="checkbox" id="toggle-motion" aria-label="減少動畫效果">
            <span class="a11y-switch-thumb"></span>
          </div>
        </label>
        <label class="a11y-toggle">
          <span class="a11y-toggle-label">增加行距</span>
          <div class="a11y-switch" role="switch">
            <input type="checkbox" id="toggle-spacing" aria-label="增加行距">
            <span class="a11y-switch-thumb"></span>
          </div>
        </label>
        <label class="a11y-toggle">
          <span class="a11y-toggle-label">強調連結底線</span>
          <div class="a11y-switch" role="switch">
            <input type="checkbox" id="toggle-links" aria-label="強調連結底線">
            <span class="a11y-switch-thumb"></span>
          </div>
        </label>
      </div>
    </div>

    <button id="a11y-reset" class="a11y-reset-btn">重置所有設定</button>
  </div>
</div>

<style>
  /* ── 懸浮按鈕 ── */
  #a11y-widget {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 9999;
    font-family: system-ui, -apple-system, sans-serif;
  }

  #a11y-trigger {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 12px 14px 10px;
    background: #534AB7;
    color: #fff;
    border: none;
    border-radius: 16px;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
    box-shadow: 0 4px 16px rgba(83,74,183,0.35);
  }

  #a11y-trigger:hover {
    background: #3C3489;
    transform: translateY(-2px);
  }

  #a11y-trigger:focus-visible {
    outline: 3px solid #7F77DD;
    outline-offset: 3px;
  }

  .a11y-trigger-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  /* ── 面板 ── */
  #a11y-panel {
    position: absolute;
    bottom: calc(100% + 12px);
    right: 0;
    width: 260px;
    background: #ffffff;
    border: 1px solid #e4e2f5;
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(83,74,183,0.18);
    overflow: hidden;
    transform-origin: bottom right;
    animation: panelIn 0.18s ease;
  }

  #a11y-panel[hidden] {
    display: none;
  }

  @keyframes panelIn {
    from { opacity: 0; transform: scale(0.92) translateY(8px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }

  .a11y-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px 12px;
    border-bottom: 1px solid #f0eefa;
  }

  .a11y-panel-title {
    font-size: 13px;
    font-weight: 600;
    color: #3C3489;
  }

  #a11y-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: none;
    border: none;
    color: #888780;
    cursor: pointer;
    border-radius: 6px;
    transition: background 0.15s;
  }

  #a11y-close:hover { background: #f0eefa; }

  #a11y-close:focus-visible {
    outline: 2px solid #534AB7;
    outline-offset: 2px;
  }

  /* ── 各 section ── */
  .a11y-section {
    padding: 12px 16px;
    border-bottom: 1px solid #f5f3fc;
  }

  .a11y-section-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #888780;
    margin-bottom: 8px;
  }

  /* ── 選項按鈕組 ── */
  .a11y-btn-group {
    display: flex;
    gap: 6px;
  }

  .a11y-option {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    padding: 8px 4px;
    background: #f5f3fc;
    border: 1.5px solid transparent;
    border-radius: 10px;
    cursor: pointer;
    font-size: 11px;
    color: #5F5E5A;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    line-height: 1.3;
  }

  .a11y-option:hover {
    background: #eeedfe;
    color: #3C3489;
  }

  .a11y-option[aria-pressed="true"],
  .a11y-option.active {
    background: #eeedfe;
    border-color: #7F77DD;
    color: #3C3489;
    font-weight: 600;
  }

  .a11y-option:focus-visible {
    outline: 2px solid #534AB7;
    outline-offset: 2px;
  }

  .a11y-option-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 22px;
    font-weight: 700;
    line-height: 1;
  }

  /* ── Toggle switches ── */
  .a11y-toggle-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .a11y-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
  }

  .a11y-toggle-label {
    font-size: 13px;
    color: #444441;
  }

  .a11y-switch {
    position: relative;
    width: 36px;
    height: 20px;
    flex-shrink: 0;
  }

  .a11y-switch input {
    opacity: 0;
    width: 0;
    height: 0;
    position: absolute;
  }

  .a11y-switch-thumb {
    position: absolute;
    inset: 0;
    background: #D3D1C7;
    border-radius: 20px;
    transition: background 0.2s;
    cursor: pointer;
  }

  .a11y-switch-thumb::after {
    content: '';
    position: absolute;
    left: 3px;
    top: 3px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #fff;
    transition: transform 0.2s;
  }

  .a11y-switch input:checked + .a11y-switch-thumb {
    background: #534AB7;
  }

  .a11y-switch input:checked + .a11y-switch-thumb::after {
    transform: translateX(16px);
  }

  .a11y-switch input:focus-visible + .a11y-switch-thumb {
    outline: 2px solid #534AB7;
    outline-offset: 2px;
  }

  /* ── 重置按鈕 ── */
  .a11y-reset-btn {
    display: block;
    width: calc(100% - 32px);
    margin: 12px 16px;
    padding: 8px;
    background: none;
    border: 1px solid #D3D1C7;
    border-radius: 8px;
    font-size: 12px;
    color: #888780;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .a11y-reset-btn:hover {
    border-color: #E24B4A;
    color: #A32D2D;
  }

  .a11y-reset-btn:focus-visible {
    outline: 2px solid #534AB7;
    outline-offset: 2px;
  }

  /* ── 套用到 :root 的 CSS 變數，供全站使用 ── */

  /* 字體大小 */
  :root[data-font="large"]  { font-size: 118%; }
  :root[data-font="xl"]     { font-size: 138%; }

  /* 高對比 */
  :root[data-contrast="high"] {
    --a11y-bg: #ffffff;
    --a11y-text: #000000;
    --a11y-accent: #00008B;
    filter: contrast(1.5);
  }

  /* 暗色模式 */
  :root[data-contrast="dark"] {
    color-scheme: dark;
    --a11y-bg: #0f0f0f;
    --a11y-text: #f5f5f5;
    --a11y-accent: #AFA9EC;
    background-color: var(--a11y-bg);
    color: var(--a11y-text);
  }

  /* 減少動畫 */
  :root[data-reduce-motion="true"] *,
  :root[data-reduce-motion="true"] *::before,
  :root[data-reduce-motion="true"] *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }

  /* 增加行距 */
  :root[data-line-spacing="true"] body,
  :root[data-line-spacing="true"] p,
  :root[data-line-spacing="true"] li,
  :root[data-line-spacing="true"] span {
    line-height: 2 !important;
    letter-spacing: 0.02em;
  }

  /* 強調連結 */
  :root[data-links="true"] a {
    text-decoration: underline !important;
    text-decoration-thickness: 2px !important;
    text-underline-offset: 3px !important;
  }

  /* 面板在暗色模式下也要看得到 */
  @media (prefers-color-scheme: dark) {
    #a11y-panel {
      background: #1e1b2e;
      border-color: #3C3489;
      color: #f5f5f5;
    }
    .a11y-panel-title { color: #AFA9EC; }
    .a11y-panel-header { border-color: #2d2a45; }
    .a11y-section { border-color: #2d2a45; }
    .a11y-option { background: #2d2a45; color: #D3D1C7; }
    .a11y-option:hover,
    .a11y-option.active { background: #3C3489; color: #EEEDFE; }
    .a11y-toggle-label { color: #D3D1C7; }
    .a11y-reset-btn { border-color: #3C3489; color: #888780; }
    #a11y-close:hover { background: #2d2a45; }
  }
</style>

<script>
  const STORAGE_KEY = 'a11y-prefs';

  const defaults = {
    font: 'normal',
    contrast: 'normal',
    motion: false,
    spacing: false,
    links: false,
  };

  function loadPrefs(): typeof defaults {
    try {
      return { ...defaults, ...JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}') };
    } catch {
      return { ...defaults };
    }
  }

  function savePrefs(prefs: typeof defaults) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs)); } catch {}
  }

  function applyPrefs(prefs: typeof defaults) {
    const root = document.documentElement;

    // font
    root.removeAttribute('data-font');
    if (prefs.font !== 'normal') root.setAttribute('data-font', prefs.font);

    // contrast / dark
    root.removeAttribute('data-contrast');
    if (prefs.contrast !== 'normal') root.setAttribute('data-contrast', prefs.contrast);

    // toggles
    root.setAttribute('data-reduce-motion', String(prefs.motion));
    root.setAttribute('data-line-spacing', String(prefs.spacing));
    root.setAttribute('data-links', String(prefs.links));
  }

  function syncUI(prefs: typeof defaults) {
    // font buttons
    document.querySelectorAll<HTMLButtonElement>('[data-action="font"]').forEach(btn => {
      const active = btn.dataset.value === prefs.font;
      btn.setAttribute('aria-pressed', String(active));
      btn.classList.toggle('active', active);
    });

    // contrast buttons
    document.querySelectorAll<HTMLButtonElement>('[data-action="contrast"]').forEach(btn => {
      const active = btn.dataset.value === prefs.contrast;
      btn.setAttribute('aria-pressed', String(active));
      btn.classList.toggle('active', active);
    });

    // toggles
    (document.getElementById('toggle-motion') as HTMLInputElement).checked = prefs.motion;
    (document.getElementById('toggle-spacing') as HTMLInputElement).checked = prefs.spacing;
    (document.getElementById('toggle-links') as HTMLInputElement).checked = prefs.links;
  }

  // ── 初始化 ──
  const prefs = loadPrefs();
  applyPrefs(prefs);

  document.addEventListener('DOMContentLoaded', () => {
    syncUI(prefs);

    const trigger  = document.getElementById('a11y-trigger')!;
    const panel    = document.getElementById('a11y-panel')!;
    const closeBtn = document.getElementById('a11y-close')!;
    const resetBtn = document.getElementById('a11y-reset')!;

    // 開關面板
    function openPanel() {
      panel.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      closeBtn.focus();
    }
    function closePanel() {
      panel.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      trigger.focus();
    }

    trigger.addEventListener('click', () =>
      panel.hidden ? openPanel() : closePanel()
    );
    closeBtn.addEventListener('click', closePanel);

    // Esc 關閉
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) closePanel();
    });

    // 點外面關閉
    document.addEventListener('click', (e) => {
      const widget = document.getElementById('a11y-widget')!;
      if (!panel.hidden && !widget.contains(e.target as Node)) closePanel();
    });

    // 選項按鈕
    document.querySelectorAll<HTMLButtonElement>('[data-action]').forEach(btn => {
      btn.addEventListener('click', () => {
        const action = btn.dataset.action as 'font' | 'contrast';
        const value  = btn.dataset.value!;
        prefs[action] = value as any;
        applyPrefs(prefs);
        syncUI(prefs);
        savePrefs(prefs);
      });
    });

    // Toggle switches
    document.getElementById('toggle-motion')!.addEventListener('change', (e) => {
      prefs.motion = (e.target as HTMLInputElement).checked;
      applyPrefs(prefs); savePrefs(prefs);
    });
    document.getElementById('toggle-spacing')!.addEventListener('change', (e) => {
      prefs.spacing = (e.target as HTMLInputElement).checked;
      applyPrefs(prefs); savePrefs(prefs);
    });
    document.getElementById('toggle-links')!.addEventListener('change', (e) => {
      prefs.links = (e.target as HTMLInputElement).checked;
      applyPrefs(prefs); savePrefs(prefs);
    });

    // 重置
    resetBtn.addEventListener('click', () => {
      Object.assign(prefs, defaults);
      applyPrefs(prefs);
      syncUI(prefs);
      savePrefs(prefs);
    });
  });
</script>