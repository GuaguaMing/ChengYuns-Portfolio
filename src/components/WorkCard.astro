---
import type { Work } from '../lib/works';
import { workHref } from '../lib/works';
import { getWorkMedia } from '../lib/media';
import Cover from './Cover.astro';
import Tag from './Tag.astro';
import Badge from './Badge.astro';

interface Props {
  work: Work;
  wide?: boolean;
}
const { work, wide } = Astro.props;
const { title, role, summary, tags, badge, highlight, period, year } = work.data;
const { cover } = getWorkMedia(work.id);
---
<a
  href={workHref(work)}
  class="card group flex flex-col transition hover:-translate-y-1"
>
  <div class:list={['overflow-hidden rounded-t-[3px] border-b-[1.5px] border-ink bg-subtle', wide ? 'aspect-[16/7]' : 'aspect-[16/10]']}>
    <Cover src={cover} alt={title} class="size-full transition duration-500 group-hover:scale-[1.04]" />
  </div>
  <div class="flex flex-1 flex-col gap-3 p-6 md:p-7">
    <div class="flex flex-wrap gap-2">{tags.map((t) => <Tag>{t}</Tag>)}</div>
    <h3 class="text-2xl font-bold">{title}</h3>
    <p class="font-mono text-xs text-muted">Role — {role} · {period ?? year}</p>
    <p class="leading-[1.7]">{summary}</p>
    {(badge || highlight) && (
      <div class="mt-auto flex flex-wrap items-center gap-3 pt-2">
        {badge && <Badge>{badge}</Badge>}
        {highlight && <span class="text-sm text-muted">{highlight}</span>}
      </div>
    )}
  </div>
</a>
