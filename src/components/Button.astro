---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  arrow?: boolean;
  external?: boolean;
  class?: string;
}
const { href, variant = 'primary', arrow = true, external = /^https?:/.test(href), class: cls } = Astro.props;
---
<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  class:list={[
    'inline-flex items-center gap-2 rounded-full border-[1.5px] border-ink px-6 py-3 text-[15px] font-bold transition',
    variant === 'primary'
      ? 'bg-mint text-ink misreg hover:-translate-y-0.5 hover:[--misreg-x:4px] hover:[--misreg-y:3px]'
      : 'bg-transparent text-ink hover:bg-sun',
    cls,
  ]}
>
  <slot />{arrow && <span aria-hidden="true">{external ? '↗' : '→'}</span>}
</a>
