---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Placeholder from './Placeholder.astro';

interface Props {
  src?: ImageMetadata;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
}
const { src, alt, class: cls, widths = [480, 800, 1200], sizes = '(min-width: 768px) 50vw, 100vw', eager } = Astro.props;
---
{
  src ? (
    <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} class:list={['object-cover', cls]} />
  ) : (
    <Placeholder class={cls} />
  )
}
