---
import type { ImageMetadata } from 'astro';
import Cover from './Cover.astro';
import Badge from './Badge.astro';

interface Props {
  href: string;
  index: string;
  title: string;
  keywords: string;
  count: string;
  cover?: ImageMetadata;
}
const { href, index, title, keywords, count, cover } = Astro.props;
---
<a href={href} class="card group flex flex-col gap-5 p-6 transition hover:-translate-y-1 md:p-7">
  <div class="flex items-center justify-between">
    <span class="font-mono text-sm text-muted">{index}</span><Badge>{count}</Badge>
  </div>
  <div class="aspect-[16/8] overflow-hidden rounded-[3px] border border-ink/20 bg-subtle">
    <Cover src={cover} alt={title} class="size-full transition duration-500 group-hover:scale-[1.04]" />
  </div>
  <div class="flex flex-col gap-2">
    <h3 class="text-2xl font-bold md:text-[28px]">{title}</h3>
    <p class="font-mono text-xs text-muted">{keywords}</p>
  </div>
  <span class="flex items-center justify-between text-sm font-bold">進入分類 <span aria-hidden="true">↗</span></span>
</a>
