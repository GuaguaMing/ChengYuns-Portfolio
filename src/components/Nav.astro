---
import { url } from '../lib/url';
import { nav } from '../data/site';
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b-[1.5px] border-ink bg-canvas">
  <div class="container-page flex h-[72px] items-center justify-between gap-6">
    <a href={url('/')} class="flex items-center gap-2.5 font-bold tracking-wide">
      <span class="misreg grid size-9 place-items-center rounded-full bg-mint text-lg" aria-hidden="true">Ψ</span>CHENGYUN
    </a>
    <nav aria-label="主選單" class="hidden items-center gap-8 lg:flex">
      {nav.map((n) => (
        <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined} class="text-[15px] font-medium text-muted transition hover:text-ink aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:decoration-sun aria-[current=page]:decoration-[5px] aria-[current=page]:underline-offset-8">
          {n.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <a href={url('/about/#contact')} class="misreg rounded-full border-[1.5px] border-ink bg-mint px-5 py-2.5 text-sm font-bold">聯絡我</a>
      <details class="relative lg:hidden">
        <summary class="grid size-10 cursor-pointer list-none place-items-center rounded-full border-[1.5px] border-ink" aria-label="開啟選單">☰</summary>
        <nav aria-label="行動版選單" class="card absolute right-0 mt-3 flex w-56 flex-col p-2">
          {nav.map((n) => <a href={n.href} class="rounded-lg px-4 py-3 font-medium hover:bg-sun">{n.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>
